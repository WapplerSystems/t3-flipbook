    <sheets>
        <options>
            <ROOT>
                <sheetTitle>LLL:EXT:flipbook/Resources/Private/Language/locallang_db.xlf:flexform.sheet.options</sheetTitle>
                <type>array</type>
                <el>
                    <settings.fullbook type="array">
                        <label>Full-Width Book</label>
                        <config type="array">
                            <type>check</type>
                        </config>
                    </settings.fullbook>
                    <settings.header type="array">
                        <label>LLL:EXT:flipbook/Resources/Private/Language/locallang_db.xlf:flexform.sheet.options.header</label>
                        <config type="array">
                            <type>input</type>
                            <size>48</size>
                            <eval>trim</eval>
                        </config>
                    </settings.header>
                    <settings.download>
                        <label>LLL:EXT:flipbook/Resources/Private/Language/locallang_db.xlf:flexform.sheet.options.download</label>
                        <config>
                            <type>link</type>
                        </config>
                    </settings.download>
                    <settings.preview>
                        <label>LLL:EXT:flipbook/Resources/Private/Language/locallang_db.xlf:flexform.sheet.options.thumb</label>
                        <config>
                            <type>inline</type>
                            <appearance type="array">
                                <enabledControls type="array">
                                    <delete>1</delete>
                                    <dragdrop>1</dragdrop>
                                    <hide>1</hide>
                                    <info>1</info>
                                    <localize>1</localize>
                                </enabledControls>
                                <headerThumbnail type="array">
                                    <field>uid_local</field>
                                    <height>45c</height>
                                    <width>45</width>
                                </headerThumbnail>
                                <useSortable>1</useSortable>
                            </appearance>
                            <behaviour type="array">
                                <localizationMode>select</localizationMode>
                                <localizeChildrenAtParentLocalization>1</localizeChildrenAtParentLocalization>
                            </behaviour>
                            <filter type="array"/>
                            <foreign_field>uid_foreign</foreign_field>
                            <foreign_label>uid_local</foreign_label>
                            <foreign_match_fields type="array">
                                <fieldname>settings.preview</fieldname>
                            </foreign_match_fields>
                            <foreign_selector>uid_local</foreign_selector>
                            <foreign_selector_fieldTcaOverride type="array">
                                <config type="array">
                                    <appearance type="array">
                                        <elementBrowserAllowed>gif,jpg,jpeg,tif,tiff,bmp,pcx,tga,png,pdf,ai
                                            </elementBrowserAllowed>
                                        <elementBrowserType>file</elementBrowserType>
                                    </appearance>
                                </config>
                            </foreign_selector_fieldTcaOverride>
                            <foreign_sortby>sorting_foreign</foreign_sortby>
                            <foreign_table>sys_file_reference</foreign_table>
                            <foreign_table_field>tablenames</foreign_table_field>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.preview>
                    <settings.description>
                        <config type="array">
                            <type>text</type>
                            <cols>48</cols>
                            <rows>5</rows>
                        </config>
                        <label>LLL:EXT:flipbook/Resources/Private/Language/locallang_db.xlf:flexform.sheet.options.description</label>
                        <defaultExtras>richtext[*]:rte_transform[flag=rte_enabled|mode=ts_css]</defaultExtras>
                    </settings.description>
                </el>
            </ROOT>
        </options>
        <sDEF>
            <ROOT>
                <sheetTitle>LLL:EXT:flipbook/Resources/Private/Language/locallang_db.xlf:flexform.sheet.folder</sheetTitle>
                <type>array</type>
                <el>
                    <settings.mode type="array">
                        <label>LLL:EXT:flipbook/Resources/Private/Language/locallang_db.xlf:flexform.sheet.options.mode</label>
                        <onChange>reload</onChange>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items type="array">
                                <numIndex index="0" type="array">
                                    <label>Create Flipbook from folders</label>
                                    <value>folders</value>
                                </numIndex>
                                <numIndex index="1" type="array">
                                    <label>Create Flipbook from pdf</label>
                                    <value>pdf</value>
                                </numIndex>
                            </items>
                        </config>
                    </settings.mode>
                    <settings.folder>
                        <label>LLL:EXT:flipbook/Resources/Private/Language/locallang_db.xlf:flexform.sheet.folder.bigimages</label>
                        <displayCond>FIELD:settings.mode:=:folders</displayCond>
                        <config>
                            <type>folder</type>
                            <max_size>1</max_size>
                            <maxitems>1</maxitems>
                            <minitems>1</minitems>
                            <autoSizeMax>1</autoSizeMax>
                            <required>1</required>
                        </config>
                    </settings.folder>
                    <settings.thumbs>
                        <label>LLL:EXT:flipbook/Resources/Private/Language/locallang_db.xlf:flexform.sheet.folder.smallimages</label>
                        <displayCond>FIELD:settings.mode:=:folders</displayCond>
                        <config>
                            <type>folder</type>
                            <max_size>1</max_size>
                            <maxitems>1</maxitems>
                            <autoSizeMax>1</autoSizeMax>
                        </config>
                    </settings.thumbs>
                    <settings.pdfUrl>
                        <label>LLL:EXT:flipbook/Resources/Private/Language/locallang_db.xlf:flexform.sheet.pdf.file</label>
                        <displayCond>FIELD:settings.mode:=:pdf</displayCond>
                        <config>
                            <type>link</type>
                        </config>
                    </settings.pdfUrl>
                </el>
            </ROOT>
        </sDEF>
